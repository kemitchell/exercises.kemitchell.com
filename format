#!/usr/bin/env node
import { load, dump } from 'js-yaml'
import { readFileSync, writeFileSync, globSync } from 'fs'

for (const file of globSync('data/**/*.yml')) {
  const data = load(readFileSync(file, 'utf8'))
  writeFileSync(
    file,
    dump(data, {
      indent: 2,
      noArrayIndent: true,
      lineWidth: -1, // unlimited
      quotingType: "'",
      forceQuotes: false
    })
  )
}
